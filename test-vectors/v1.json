[
  {
    "name": "upi static exact amount",
    "payload": "upi://pay?pa=merchant%40bank&pn=Example&am=499.00&cu=INR",
    "expected": { "recognized": true, "scheme": "upi", "valid": true, "amount": "499.00" }
  },
  {
    "name": "pix public manual-style static payload",
    "payload": "00020126360014BR.GOV.BCB.PIX0114+55119999999995204000053039865802BR5913FULANO DE TAL6008BRASILIA62070503***6304C23A",
    "expected": { "recognized": true, "scheme": "pix", "valid": true }
  },
  {
    "name": "ordinary website is recognized as a generic URL, not a payment",
    "payload": "https://example.com/docs",
    "expected": { "recognized": true, "scheme": "url", "valid": true }
  },
  {
    "name": "truly unstructured input is not recognized at all",
    "payload": "just some plain text with no structure at all",
    "expected": { "recognized": false, "scheme": "unknown", "valid": false }
  },
  {
    "name": "invalid EMV checksum",
    "payload": "00020126360014BR.GOV.BCB.PIX0114+55119999999995204000053039865802BR5913FULANO DE TAL6008BRASILIA62070503***63040000",
    "expected": { "recognized": true, "scheme": "pix", "valid": false, "error": "INVALID_CHECKSUM" }
  },
  {
    "name": "multibyte unicode near the EMV tail must not panic detection",
    "payload": "000201€€€",
    "expected": { "recognized": false, "scheme": "unknown", "valid": false }
  },
  {
    "name": "multibyte unicode reaching Pix CRC validation must not panic",
    "payload": "000201br.gov.bcb.pix€€€",
    "expected": { "recognized": true, "scheme": "pix", "valid": false, "error": "MALFORMED_PAYLOAD" }
  },
